rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null
             && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isMember() && request.auth.token.admin == true;
    }

    function freshAdmin() {
      return isAdmin()
             && request.time.toMillis() - request.auth.token.auth_time * 1000 < 900000
             && request.auth.token.firebase.sign_in_second_factor == 'totp';
    }

    function validImage(maxBytes) {
      return request.resource != null
             && request.resource.size > 0
             && request.resource.size < maxBytes
             && request.resource.contentType.matches(
                  'image/(jpeg|jpg|png|webp|gif|heic|heif)');
    }

    // Display variants preserve the uploader's uid after the "display" segment.
    match /photos/display/{uid}/{allPaths=**} {
      allow read: if isMember();
      allow create: if isMember() && request.auth.uid == uid
                    && validImage(15 * 1024 * 1024);
      allow delete: if isMember() && (request.auth.uid == uid || freshAdmin());
      allow update: if false;
    }

    match /photos/{uid}/{allPaths=**} {
      allow read: if isMember();
      allow create: if isMember() && request.auth.uid == uid
                    && validImage(15 * 1024 * 1024);
      allow delete: if isMember() && (request.auth.uid == uid || freshAdmin());
      allow update: if false;
    }

    match /avatars/{uid}/{allPaths=**} {
      allow read: if isMember();
      allow create: if isMember() && request.auth.uid == uid
                    && validImage(5 * 1024 * 1024);
      allow delete: if isMember() && (request.auth.uid == uid || freshAdmin());
      allow update: if false;
    }
  }
}
