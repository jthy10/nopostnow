rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
             && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Admin mutations require a password re-entry within the last 15 minutes
    // (the /admin page reauthenticates on entry, which refreshes auth_time).
    // A stolen long-lived session can browse but cannot run admin actions.
    // Admin mutations also require a TOTP-verified session.
    function freshAdmin() {
      return isAdmin()
             && request.time.toMillis() - request.auth.token.auth_time * 1000 < 900000
             && request.auth.token.firebase.sign_in_second_factor == 'totp';
    }

    function validReactionList(list) {
      return list is list
             && list.size() <= 500
             && list.toSet().size() == list.size();
    }

    function validUserProfile(email) {
      return request.resource.data.keys().hasOnly(
               ['username', 'avatarPath', 'uid', 'joinedAt', 'appAt', 'createdAt', 'muted'])
             && request.resource.data.username is string
             && request.resource.data.username.size() >= 2
             && request.resource.data.username.size() <= 24
             && request.resource.data.get('avatarPath', '') is string
             && request.resource.data.get('avatarPath', '').size() <= 500
             && request.resource.data.uid == request.auth.uid
             && request.resource.data.get('muted', false) is bool
             && request.auth.token.email == email;
    }

    // users/{email} -> { username, avatarPath, uid, joinedAt, muted }
    // uid backs the /u/[uid] profile pages — nobody may claim another's uid,
    // and only the admin can set or clear the muted flag.
    match /users/{email} {
      allow read: if (signedIn()
                      && (request.auth.token.email == email
                          || resource.data.uid == request.auth.uid))
                  || isAdmin();
      allow create, update: if (signedIn()
                       && validUserProfile(email)
                       && (!request.resource.data.keys().hasAny(['muted'])
                           || (resource != null
                               && request.resource.data.muted == resource.data.muted)))
                   || freshAdmin();
      // Changing your login email leaves the old users/{email} doc behind
      // (the token's email no longer matches it) — the owner may clean up
      // their own orphan, proven by the uid stored inside it.
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid)
                    || freshAdmin();
    }

    function validPublicProfile(uid) {
      return request.resource.data.keys().hasOnly(
               ['username', 'avatarPath', 'uid', 'joinedAt', 'appAt'])
             && request.resource.data.username is string
             && request.resource.data.username.size() >= 2
             && request.resource.data.username.size() <= 24
             && request.resource.data.uid == request.auth.uid
             && request.resource.data.uid == uid
             && request.resource.data.get('avatarPath', '') is string
             && request.resource.data.get('avatarPath', '').size() <= 500
             && (request.resource.data.get('avatarPath', '') == ''
                 || request.resource.data.get('avatarPath', '').matches(
                      'avatars/' + request.auth.uid + '/.*'))
             && request.resource.data.get('joinedAt', request.time) is timestamp
             && request.resource.data.get('appAt', request.time) is timestamp;
    }

    // Email-free projection used by search, avatars, profiles, mentions, and
    // direct messages. A member can edit only their own UID-keyed document.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if (signedIn()
                                && request.auth.uid == uid
                                && validPublicProfile(uid))
                            || freshAdmin();
      allow delete: if (signedIn() && request.auth.uid == uid)
                    || freshAdmin();
    }

    function ownUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.username;
    }

    // Admin mute: muted members can browse and like but not post or comment.
    function notMuted() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email))
               .data.get('muted', false) != true;
    }

    // config/{docId} -> app-wide settings the admin edits (feed announcement).
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if freshAdmin();
    }

    // adminLog/{entryId} -> append-only audit trail of admin actions.
    // No update/delete ever — the log can't be quietly rewritten.
    match /adminLog/{entryId} {
      allow read: if isAdmin();
      allow create: if freshAdmin() && request.resource.data.at == request.time;
    }

    // unique_users/{uid} -> { firstJoined, email }, sessions/{sessionId} -> { startTime, likedPhotos }
    match /unique_users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if signedIn() && request.auth.uid == uid;

      match /sessions/{sessionId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // pushSubscriptions/{endpointHash} -> { uid, endpoint, p256dh, auth, updatedAt }
    // Subscription endpoints are private. Server routes use Firebase Admin to
    // fan out notifications and remove stale endpoints.
    match /pushSubscriptions/{subId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid)
                    || freshAdmin();
      allow create, update: if signedIn()
                            && request.resource.data.keys().hasOnly(
                                 ['uid', 'endpoint', 'p256dh', 'auth', 'updatedAt'])
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.endpoint is string
                            && request.resource.data.endpoint.size() <= 2048
                            && request.resource.data.p256dh is string
                            && request.resource.data.p256dh.size() <= 512
                            && request.resource.data.auth is string
                            && request.resource.data.auth.size() <= 512
                            && request.resource.data.updatedAt == request.time;
    }

    // notifications/{uid} -> { seenAt }, items/{itemId} -> in-app bell feed.
    // Anyone signed in may drop an item into a friend's feed, but only as
    // themselves (actorUid/actorName verified) and never into their own.
    // Types carrying text (post caption / comment) also require notMuted,
    // matching who is allowed to create that content in the first place.
    match /notifications/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['seenAt'])
                            && request.resource.data.seenAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;

      match /items/{itemId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        // Rename propagation: the actor may restamp their own display name
        // (verified against their users doc) — nothing else ever changes.
        allow update: if signedIn()
                      && resource.data.actorUid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actorName'])
                      && request.resource.data.actorName == ownUsername();
        allow create: if signedIn()
                      && uid != request.auth.uid
                      && request.resource.data.keys().hasOnly(
                           ['type', 'actorUid', 'actorName', 'postId', 'text', 'at'])
                      && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.actorName == ownUsername()
                      && request.resource.data.postId is string
                      && request.resource.data.postId.size() <= 120
                      && request.resource.data.at == request.time
                      // Text-carrying pings (post caption / comment / @mention)
                      // require notMuted, matching who may author that content;
                      // reaction pings (photo like / comment like) carry no text.
                      && ((request.resource.data.type in ['post', 'comment', 'mention']
                           && notMuted()
                           && request.resource.data.get('text', '') is string
                           && request.resource.data.get('text', '').size() <= 200)
                          || (request.resource.data.type in ['like', 'commentLike']
                              && !request.resource.data.keys().hasAny(['text'])));
      }
    }

    // notifPrefs/{uid} -> { uid, posts, comments, likes, dms, dailyPrompt,
    //                       quietStart, quietEnd, tz, updatedAt }
    // Push notification preferences + quiet hours. Only the owner may read or
    // write them; trusted server routes read them with Firebase Admin.
    match /notifPrefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(
                        ['uid', 'posts', 'comments', 'likes', 'dms', 'dailyPrompt',
                         'quietStart', 'quietEnd', 'tz', 'updatedAt'])
                   && request.resource.data.uid == uid
                   && request.resource.data.posts is bool
                   && request.resource.data.comments is bool
                   && request.resource.data.likes is bool
                   && request.resource.data.dms is bool
                   && request.resource.data.dailyPrompt is bool
                   && (request.resource.data.quietStart == null
                       || (request.resource.data.quietStart is int
                           && request.resource.data.quietStart >= 0
                           && request.resource.data.quietStart <= 1439))
                   && (request.resource.data.quietEnd == null
                       || (request.resource.data.quietEnd is int
                           && request.resource.data.quietEnd >= 0
                           && request.resource.data.quietEnd <= 1439))
                   && request.resource.data.tz is string
                   && request.resource.data.tz.size() <= 64;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // blocks/{uid} -> { blocked: [uid, ...] } — people this user blocked.
    // Readable by any member: blocking is mutual invisibility, so clients
    // must be able to find lists containing them (array-contains query).
    // Only the owner edits their own list, and only that one field.
    match /blocks/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['blocked'])
                   && request.resource.data.blocked is list
                   && request.resource.data.blocked.size() <= 500;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // dms/{threadId} -> { uids: [a, b], names, lastText, lastFrom, lastAt, seenAt }
    // threadId is both uids sorted and joined with '_' (uids never contain
    // underscores), so membership is checkable from the id alone — no extra
    // get() on every message read. Only the two participants see anything.
    match /dms/{threadId} {
      // get is id-based so peeking at a thread that doesn't exist yet works;
      // list must be data-based — Firestore can only prove it from the
      // client's array-contains filter, never from the doc id.
      allow get: if signedIn() && request.auth.uid in threadId.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.uids;
      allow create: if signedIn()
                    && request.auth.uid in threadId.split('_')
                    && request.resource.data.keys().hasOnly(
                         ['uids', 'names', 'lastText', 'lastFrom', 'lastAt', 'seenAt'])
                    && request.resource.data.uids is list
                    && request.resource.data.uids.size() == 2
                    && request.resource.data.uids[0] < request.resource.data.uids[1]
                    && threadId == request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
                    && request.resource.data.names is map
                    && request.resource.data.names.keys().hasOnly(request.resource.data.uids)
                    && request.resource.data.names[request.auth.uid] == ownUsername()
                    && request.resource.data.lastText is string
                    && request.resource.data.lastText.size() > 0
                    && request.resource.data.lastText.size() <= 120
                    && request.resource.data.lastFrom == request.auth.uid
                    && request.resource.data.lastAt == request.time
                    && request.resource.data.seenAt is map
                    && request.resource.data.seenAt.keys().hasOnly([request.auth.uid])
                    && request.resource.data.seenAt[request.auth.uid] == request.time;
      // Participants may send, advance their own seen pointer, or refresh only
      // their own cached name. Membership and the peer's fields stay frozen.
      allow update: if signedIn()
                    && request.auth.uid in threadId.split('_')
                    && request.resource.data.keys().hasOnly(
                         ['uids', 'names', 'lastText', 'lastFrom', 'lastAt', 'seenAt'])
                    && request.resource.data.uids == resource.data.uids
                    && (
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                           ['names', 'lastText', 'lastFrom', 'lastAt', 'seenAt'])
                       && request.resource.data.names is map
                       && request.resource.data.names.diff(resource.data.names)
                            .affectedKeys().hasOnly([request.auth.uid])
                       && request.resource.data.names[request.auth.uid] == ownUsername()
                       && request.resource.data.lastText is string
                       && request.resource.data.lastText.size() > 0
                       && request.resource.data.lastText.size() <= 120
                       && request.resource.data.lastFrom == request.auth.uid
                       && request.resource.data.lastAt == request.time
                       && request.resource.data.seenAt is map
                       && request.resource.data.seenAt.diff(resource.data.seenAt)
                            .affectedKeys().hasOnly([request.auth.uid])
                       && request.resource.data.seenAt[request.auth.uid] == request.time)
                      ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])
                       && request.resource.data.seenAt is map
                       && request.resource.data.seenAt.diff(resource.data.seenAt)
                            .affectedKeys().hasOnly([request.auth.uid])
                       && request.resource.data.seenAt[request.auth.uid] == request.time)
                      ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
                       && request.resource.data.names is map
                       && request.resource.data.names.diff(resource.data.names)
                            .affectedKeys().hasOnly([request.auth.uid])
                       && request.resource.data.names[request.auth.uid] == ownUsername())
                    );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
                    && request.auth.uid in
                         get(/databases/$(database)/documents/dms/$(threadId)).data.uids;
        allow create: if signedIn()
                      && request.auth.uid in
                           get(/databases/$(database)/documents/dms/$(threadId)).data.uids
                      && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000
                      && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // photos/{photoId} -> { userUUID, username, imagePath, caption, timestamp, likedBy: [uid, ...] }
    match /photos/{photoId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && notMuted()
                    && request.resource.data.keys().hasOnly(
                         ['userUUID', 'username', 'imagePath', 'caption', 'timestamp',
                          'likedBy', 'imageWidth', 'imageHeight'])
                    && request.resource.data.userUUID == request.auth.uid
                    && request.resource.data.username == ownUsername()
                    && request.resource.data.imagePath is string
                    && request.resource.data.imagePath.size() <= 500
                    && request.resource.data.imagePath.matches(
                         'photos/' + request.auth.uid + '/.*')
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() <= 70
                    && request.resource.data.likedBy == []
                    && request.resource.data.timestamp == request.time
                    && request.resource.data.get('imageWidth', 1) is int
                    && request.resource.data.get('imageWidth', 1) > 0
                    && request.resource.data.get('imageWidth', 1) <= 20000
                    && request.resource.data.get('imageHeight', 1) is int
                    && request.resource.data.get('imageHeight', 1) > 0
                    && request.resource.data.get('imageHeight', 1) <= 20000;
      allow delete: if (signedIn() && resource.data.userUUID == request.auth.uid)
                    || freshAdmin();
      // Updates, most-privileged first:
      //  - admin: anything (rename propagation, recovering soft-deleted posts)
      //  - owner: stamp their current username onto old posts after a rename
      //  - owner: edit their caption (same 70-char cap as create)
      //  - owner: soft-delete (deleted/deletedAt only, and only to true —
      //    recovery is an admin action)
      //  - anyone: likes — only likedBy may change, and the only uid added
      //    or removed must be the caller's own. (Set.difference/hasOnly take
      //    set/list — passing a bare list to difference() type-errors and
      //    denies everything.)
      allow update: if freshAdmin()
                    || (signedIn()
                        && resource.data.userUUID == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
                        && request.resource.data.username == ownUsername())
                    || (signedIn()
                        && resource.data.userUUID == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption'])
                        && request.resource.data.caption is string
                        && request.resource.data.caption.size() <= 70)
                    || (signedIn()
                        && resource.data.userUUID == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
                        && request.resource.data.deleted == true
                        && request.resource.data.deletedAt == request.time)
                    || (signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
                    && validReactionList(request.resource.data.likedBy)
                    && request.resource.data.likedBy.toSet()
                         .difference(resource.data.get('likedBy', []).toSet())
                         .hasOnly([request.auth.uid])
                    && resource.data.get('likedBy', []).toSet()
                         .difference(request.resource.data.likedBy.toSet())
                         .hasOnly([request.auth.uid]));

      match /comments/{commentId} {
        allow read: if signedIn();
      allow create: if signedIn()
                      && notMuted()
                      && request.resource.data.keys().hasOnly(
                           ['userUUID', 'username', 'text', 'timestamp', 'likedBy'])
                      && request.resource.data.userUUID == request.auth.uid
                      && request.resource.data.username == ownUsername()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 200
                      && request.resource.data.timestamp == request.time
                      && request.resource.data.likedBy == [];
        // Immutable except:
        //  - rename propagation: the author (or admin) restamps username so old
        //    comments follow a display-name change.
        //  - likes: anyone may toggle only their own uid in likedBy (same
        //    self-only set check as a photo's likedBy).
        allow update: if freshAdmin()
                      || (signedIn()
                          && resource.data.userUUID == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
                          && request.resource.data.username == ownUsername())
                      || (signedIn()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
                          && validReactionList(request.resource.data.likedBy)
                          && request.resource.data.likedBy.toSet()
                               .difference(resource.data.get('likedBy', []).toSet())
                               .hasOnly([request.auth.uid])
                          && resource.data.get('likedBy', []).toSet()
                               .difference(request.resource.data.likedBy.toSet())
                               .hasOnly([request.auth.uid]));
        allow delete: if (signedIn() && resource.data.userUUID == request.auth.uid)
                      || freshAdmin();
      }
    }

    // Collection-group read: /admin loads every comment in one query, and a
    // member renaming themselves finds their own comments the same way.
    // Comments are already readable per-post by any member, so this widens
    // nothing.
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn();
    }

    // Collection-group read: a member renaming themselves finds every bell
    // item they dropped into friends' feeds (to restamp actorName). Only
    // items they authored — the query must filter actorUid == their uid.
    match /{path=**}/items/{itemId} {
      allow read: if signedIn() && resource.data.actorUid == request.auth.uid;
    }

    // feedback/{noteId} -> { uid, username, email, text, at } — notes to the
    // developers, written from settings, read from the admin panel.
    match /feedback/{noteId} {
      allow read: if isAdmin();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'username', 'email', 'text', 'at'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == ownUsername()
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if freshAdmin();
    }

    // claims/{claimId} -> { postId, uid, username, email, at } — a member's
    // request to be credited as the owner of an Anonymous post. Members read
    // only their own (the feed shows "Awaiting approval"); the admin reads all
    // from the Approvals queue. Immutable once filed — approving reassigns the
    // photo and deletes the claim; declining just deletes it. Both are admin
    // actions, so delete is freshAdmin only.
    match /claims/{claimId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['postId', 'uid', 'username', 'email', 'at'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == ownUsername()
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.postId is string
                    && request.resource.data.postId.size() > 0
                    && request.resource.data.postId.size() <= 120
                    && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if freshAdmin();
    }
  }
}
